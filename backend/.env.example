# Copy this file to .env and fill in real values. Never commit .env.

# ── AWS credentials ─────────────────────────────────────────────────────────
# Enable real AWS service calls (set to true when AWS credentials are set)
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Bedrock model ────────────────────────────────────────────────────────────
# Model used for both the main pipeline and the quality judge.
# Must be enabled in the Bedrock console for the configured region.
# Required IAM permission: bedrock:InvokeModel on the model ARN.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Embedding backend for the ML/NLP pipeline ────────────────────────────────
# local   → runs all-MiniLM-L6-v2 on CPU, no AWS needed (default)
# bedrock → uses Amazon Titan Embeddings V2 via Bedrock API
EMBEDDER_BACKEND=local

# ── AWS Infrastructure Settings ──────────────────────────────────────────────
S3_BUCKET_NAME=ai-context-compiler-artifacts
CLOUDWATCH_LOG_GROUP=/aws/fastapi/ai-context-compiler

# ── Storage ──────────────────────────────────────────────────────────────────
# Leave blank to use the in-memory fallback (data lost on restart).
# Set to your DynamoDB table name for persistent storage.
# Table requirements: partition key = run_id (String), no sort key.
DYNAMODB_TABLE_NAME=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank (or omit) to allow all origins — fine for local dev only.
CORS_ORIGINS=

# ── Context Compiler Pipeline Settings ───────────────────────────────────────
MAX_CONTEXT_TOKENS=128000
RELEVANCE_THRESHOLD=0.2
OPTIMIZATION_ENABLED=true
