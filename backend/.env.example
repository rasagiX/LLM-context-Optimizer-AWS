# Copy this file to .env and fill in real values. Never commit .env.

# ── AWS credentials ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Bedrock model ────────────────────────────────────────────────────────────
# Model used for both the main pipeline and the quality judge.
# Must be enabled in the Bedrock console for the configured region.
# Required IAM permission: bedrock:InvokeModel on the model ARN.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Storage ──────────────────────────────────────────────────────────────────
# Leave blank to use the in-memory fallback (data lost on restart).
# Set to your DynamoDB table name for persistent storage.
# Table requirements: partition key = run_id (String), no sort key.
DYNAMODB_TABLE_NAME=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank (or omit) to allow all origins — fine for local dev only.
# Example: CORS_ORIGINS=https://myapp.example.com,https://staging.example.com
CORS_ORIGINS=
