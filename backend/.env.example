# Copy this file to .env and fill in real values. Never commit .env.

# ── LLM Provider — Google Gemini ─────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to use for both the main pipeline and the quality judge.
# Options: gemini-1.5-flash (default, fast + free tier)
#          gemini-1.5-pro   (higher quality, slower)
#          gemini-2.0-flash (latest, free experimental)
LLM_MODEL=gemini-1.5-flash

# ── AWS Settings (Used for AWS Bedrock, DynamoDB, CloudWatch, S3) ───────────────
AWS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Embedding backend for the ML/NLP pipeline ────────────────────────────────
# local   → runs all-MiniLM-L6-v2 on CPU, no AWS needed (default)
# bedrock → uses Amazon Titan Embeddings V2 via Bedrock API
EMBEDDER_BACKEND=local

# ── AWS Infrastructure Settings ──────────────────────────────────────────────
S3_BUCKET_NAME=ai-context-compiler-artifacts
CLOUDWATCH_LOG_GROUP=/aws/fastapi/ai-context-compiler
DYNAMODB_TABLE_NAME=TokenOptimizerRuns

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=

# ── Context Compiler Pipeline Settings ───────────────────────────────────────
MAX_CONTEXT_TOKENS=128000
RELEVANCE_THRESHOLD=0.2
OPTIMIZATION_ENABLED=true
