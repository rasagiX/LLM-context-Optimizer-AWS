# Copy this file to .env and fill in real values. Never commit .env.

# ── LLM Provider — Google Gemini ─────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to use for both the main pipeline and the quality judge.
# Options: gemini-1.5-flash (default, fast + free tier)
#          gemini-1.5-pro   (higher quality, slower)
#          gemini-2.0-flash (latest, free experimental)
LLM_MODEL=gemini-1.5-flash

# ── AWS (only needed if using DynamoDB for run storage) ──────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Leave blank to use the in-memory fallback (data lost on restart).
# Set to your DynamoDB table name for persistent storage.
# Table requirements: partition key = run_id (String), no sort key.
DYNAMODB_TABLE_NAME=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank to allow all origins — fine for local dev only.
# Example: CORS_ORIGINS=https://myapp.example.com,https://staging.example.com
CORS_ORIGINS=
